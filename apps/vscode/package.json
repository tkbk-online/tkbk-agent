{
	"name": "tkbk-agent",
	"displayName": "TKBK Agent",
	"description": "Автономный агент для кода в редакторе: Claude, GPT, DeepSeek, GLM и Grok по одному ключу TKBK. Пишет и правит файлы, запускает команды, работает с браузером и MCP — с вашим подтверждением на каждом шаге.",
	"version": "0.1.0",
	"icon": "assets/icons/icon.png",
	"engines": {
		"vscode": "^1.101.0"
	},
	"author": {
		"name": "TKBK",
		"url": "https://tkbk.online"
	},
	"license": "Apache-2.0",
	"publisher": "tkbk-online",
	"repository": {
		"type": "git",
		"url": "https://github.com/tkbk-online/tkbk-agent"
	},
	"homepage": "https://tkbk.online",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"tkbk",
		"claude",
		"gpt",
		"deepseek",
		"glm",
		"grok",
		"agent",
		"coding",
		"autonomous",
		"mcp",
		"ai",
		"wildberries",
		"ozon",
		"bitrix24",
		"amocrm",
		"cline"
	],
	"activationEvents": [
		"onLanguage",
		"onUri",
		"onStartupFinished"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "В ограниченном режиме TKBK Agent работает, но не выполняет команды в терминале и хуки до тех пор, пока папке не будет выдано доверие."
		},
		"virtualWorkspaces": {
			"supported": "limited",
			"description": "В виртуальных рабочих областях недоступны терминал, браузер и чекпоинты."
		}
	},
	"main": "./dist/extension.js",
	"contributes": {
		"icons": {
			"cline-icon": {
				"description": "cline",
				"default": {
					"fontPath": "assets/icons/cline-bot.woff",
					"fontCharacter": "\\e900"
				}
			}
		},
		"walkthroughs": [
			{
				"id": "ClineWalkthrough",
				"title": "Знакомство с TKBK Agent",
				"description": "Агент пишет код как разработчик: разбирается, планирует, делает. Пять вещей, с которых стоит начать:",
				"steps": [
					{
						"id": "welcome",
						"title": "Ставьте цель, а не промпт",
						"description": "Опишите, что должно получиться. Агент составит план, задаст вопросы и только потом начнёт писать код.",
						"media": {
							"markdown": "walkthrough/step1.md"
						}
					},
					{
						"id": "learn",
						"title": "Дайте агенту изучить проект",
						"description": "Он читает структуру и нужные файлы, чтобы правки учитывали вашу архитектуру.",
						"media": {
							"markdown": "walkthrough/step2.md"
						}
					},
					{
						"id": "advanced-features",
						"title": "Лучшие модели по одному ключу TKBK",
						"description": "Claude, GPT, DeepSeek, GLM и Grok без отдельных аккаунтов и зарубежных карт. Войдите через Telegram-бота и вставьте ключ cr_….",
						"media": {
							"markdown": "walkthrough/step3.md"
						}
					},
					{
						"id": "mcp",
						"title": "Подключайте инструменты (MCP) и скилы",
						"description": "Wildberries, Ozon, Битрикс24, amoCRM и любые MCP-серверы; готовые скилы лежат в ~/.tkbk/skills.",
						"media": {
							"markdown": "walkthrough/step4.md"
						}
					},
					{
						"id": "getting-started",
						"title": "Вы всегда контролируете",
						"description": "Каждое изменение файла и каждая команда — только после вашего подтверждения. Диффы видны до применения.",
						"media": {
							"markdown": "walkthrough/step5.md"
						},
						"content": {
							"path": "walkthrough/step5.md"
						}
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "tkbk-agent-ActivityBar",
					"title": "TKBK Agent",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"tkbk-agent-ActivityBar": [
				{
					"type": "webview",
					"id": "tkbk-agent.SidebarProvider",
					"name": "",
					"icon": "assets/icons/icon.svg"
				},
				{
					"type": "tree",
					"id": "tkbk-agent.backgroundTasks",
					"name": "Фоновые задачи",
					"icon": "assets/icons/icon.svg",
					"contextualTitle": "TKBK Agent: фоновые задачи",
					"visibility": "collapsed"
				}
			]
		},
		"commands": [
			{
				"command": "tkbk-agent.plusButtonClicked",
				"title": "Новая задача",
				"icon": "$(add)"
			},
			{
				"command": "tkbk-agent.mcpButtonClicked",
				"title": "MCP-серверы",
				"icon": "$(server)"
			},
			{
				"command": "tkbk-agent.marketplaceButtonClicked",
				"title": "Настроить агента",
				"icon": "$(wrench)"
			},
			{
				"command": "tkbk-agent.historyButtonClicked",
				"title": "История",
				"icon": "$(history)"
			},
			{
				"command": "tkbk-agent.reviewChanges",
				"title": "Проверить изменения",
				"icon": "$(checklist)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.accountButtonClicked",
				"title": "Аккаунт",
				"icon": "$(account)"
			},
			{
				"command": "tkbk-agent.settingsButtonClicked",
				"title": "Настройки",
				"icon": "$(settings-gear)"
			},
			{
				"command": "tkbk-agent.dev.createTestTasks",
				"title": "Создать тестовые задачи",
				"category": "TKBK Agent",
				"when": "cline.isDevMode"
			},
			{
				"command": "tkbk-agent.dev.expireMcpOAuthTokens",
				"title": "Сбросить OAuth-токены MCP (для тестов)",
				"category": "TKBK Agent",
				"when": "cline.isDevMode"
			},
			{
				"command": "tkbk-agent.addToChat",
				"title": "Добавить в TKBK Agent",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.addTerminalOutputToChat",
				"title": "Добавить в TKBK Agent",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.focusChatInput",
				"title": "Перейти к полю ввода",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.generateGitCommitMessage",
				"title": "Сообщение коммита с TKBK Agent",
				"category": "TKBK Agent",
				"icon": "$(cline-icon)"
			},
			{
				"command": "tkbk-agent.abortGitCommitMessage",
				"title": "Сообщение коммита с TKBK Agent — остановить",
				"category": "TKBK Agent",
				"icon": "$(debug-stop)"
			},
			{
				"command": "tkbk-agent.explainCode",
				"title": "Объяснить с TKBK Agent",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.improveCode",
				"title": "Улучшить с TKBK Agent",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.jupyterGenerateCell",
				"title": "Сгенерировать ячейку Jupyter с TKBK Agent",
				"category": "TKBK Agent",
				"icon": "$(sparkle)"
			},
			{
				"command": "tkbk-agent.jupyterExplainCell",
				"title": "Объяснить ячейку Jupyter с TKBK Agent",
				"category": "TKBK Agent",
				"icon": "$(question)"
			},
			{
				"command": "tkbk-agent.jupyterImproveCell",
				"title": "Улучшить ячейку Jupyter с TKBK Agent",
				"category": "TKBK Agent",
				"icon": "$(lightbulb)"
			},
			{
				"command": "tkbk-agent.openWalkthrough",
				"title": "Открыть знакомство с TKBK Agent",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.refreshLicense",
				"title": "Проверить план TKBK IDE (лицензию)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.cloudAgent",
				"title": "Облачный агент (Pro)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.reindexCodebase",
				"title": "Переиндексировать проект",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.backgroundTask.new",
				"title": "Фоновая задача…",
				"icon": "$(add)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.backgroundTask.refresh",
				"title": "Обновить список задач",
				"icon": "$(refresh)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.backgroundTask.apply",
				"title": "Применить изменения",
				"icon": "$(check)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.backgroundTask.open",
				"title": "Открыть worktree",
				"icon": "$(folder-opened)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.backgroundTask.showDiff",
				"title": "Показать diff",
				"icon": "$(diff)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.backgroundTask.showReport",
				"title": "Показать отчёт",
				"icon": "$(book)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.backgroundTask.reject",
				"title": "Отклонить",
				"icon": "$(trash)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.backgroundTask.cancel",
				"title": "Отменить задачу",
				"icon": "$(stop-circle)",
				"category": "TKBK Agent"
			},
			{
				"command": "tkbk-agent.backgroundTask.remove",
				"title": "Убрать из списка",
				"icon": "$(close)",
				"category": "TKBK Agent"
			}
		],
		"keybindings": [
			{
				"command": "tkbk-agent.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			},
			{
				"command": "tkbk-agent.generateGitCommitMessage",
				"when": "config.git.enabled && scmProvider == git"
			},
			{
				"command": "tkbk-agent.focusChatInput",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "!editorHasSelection"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "tkbk-agent.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == tkbk-agent.SidebarProvider"
				},
				{
					"command": "tkbk-agent.marketplaceButtonClicked",
					"group": "navigation@2",
					"when": "view == tkbk-agent.SidebarProvider"
				},
				{
					"command": "tkbk-agent.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == tkbk-agent.SidebarProvider"
				},
				{
					"command": "tkbk-agent.reviewChanges",
					"group": "navigation@4",
					"when": "view == tkbk-agent.SidebarProvider"
				},
				{
					"command": "tkbk-agent.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == tkbk-agent.SidebarProvider"
				},
				{
					"command": "tkbk-agent.backgroundTask.new",
					"group": "navigation@1",
					"when": "view == tkbk-agent.backgroundTasks"
				},
				{
					"command": "tkbk-agent.backgroundTask.refresh",
					"group": "navigation@2",
					"when": "view == tkbk-agent.backgroundTasks"
				}
			],
			"editor/context": [
				{
					"command": "tkbk-agent.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "tkbk-agent.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "tkbk-agent.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !cline.isGeneratingCommit"
				},
				{
					"command": "tkbk-agent.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && cline.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "tkbk-agent.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "tkbk-agent.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "tkbk-agent.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "tkbk-agent.generateGitCommitMessage",
					"when": "config.git.enabled && !cline.isGeneratingCommit"
				},
				{
					"command": "tkbk-agent.abortGitCommitMessage",
					"when": "config.git.enabled && cline.isGeneratingCommit"
				},
				{
					"command": "tkbk-agent.backgroundTask.apply",
					"when": "false"
				},
				{
					"command": "tkbk-agent.backgroundTask.open",
					"when": "false"
				},
				{
					"command": "tkbk-agent.backgroundTask.showDiff",
					"when": "false"
				},
				{
					"command": "tkbk-agent.backgroundTask.showReport",
					"when": "false"
				},
				{
					"command": "tkbk-agent.backgroundTask.reject",
					"when": "false"
				},
				{
					"command": "tkbk-agent.backgroundTask.cancel",
					"when": "false"
				},
				{
					"command": "tkbk-agent.backgroundTask.remove",
					"when": "false"
				},
				{
					"command": "tkbk-agent.backgroundTask.refresh",
					"when": "false"
				}
			],
			"view/item/context": [
				{
					"command": "tkbk-agent.backgroundTask.apply",
					"group": "inline@1",
					"when": "view == tkbk-agent.backgroundTasks && viewItem == tkbkTask:done"
				},
				{
					"command": "tkbk-agent.backgroundTask.showDiff",
					"group": "inline@2",
					"when": "view == tkbk-agent.backgroundTasks && viewItem == tkbkTask:done"
				},
				{
					"command": "tkbk-agent.backgroundTask.open",
					"group": "inline@3",
					"when": "view == tkbk-agent.backgroundTasks && viewItem =~ /tkbkTask:(done|failed|running)/"
				},
				{
					"command": "tkbk-agent.backgroundTask.cancel",
					"group": "inline@4",
					"when": "view == tkbk-agent.backgroundTasks && viewItem =~ /tkbkTask:(queued|preparing|running)/"
				},
				{
					"command": "tkbk-agent.backgroundTask.apply",
					"group": "1_actions@1",
					"when": "view == tkbk-agent.backgroundTasks && viewItem == tkbkTask:done"
				},
				{
					"command": "tkbk-agent.backgroundTask.showDiff",
					"group": "1_actions@2",
					"when": "view == tkbk-agent.backgroundTasks && viewItem == tkbkTask:done"
				},
				{
					"command": "tkbk-agent.backgroundTask.showReport",
					"group": "1_actions@3",
					"when": "view == tkbk-agent.backgroundTasks && viewItem =~ /tkbkTask:(done|failed|applied)/"
				},
				{
					"command": "tkbk-agent.backgroundTask.open",
					"group": "1_actions@4",
					"when": "view == tkbk-agent.backgroundTasks && viewItem =~ /tkbkTask:(done|failed|running)/"
				},
				{
					"command": "tkbk-agent.backgroundTask.reject",
					"group": "2_danger@1",
					"when": "view == tkbk-agent.backgroundTasks && viewItem =~ /tkbkTask:(done|failed)/"
				},
				{
					"command": "tkbk-agent.backgroundTask.cancel",
					"group": "2_danger@2",
					"when": "view == tkbk-agent.backgroundTasks && viewItem =~ /tkbkTask:(queued|preparing|running)/"
				},
				{
					"command": "tkbk-agent.backgroundTask.remove",
					"group": "2_danger@3",
					"when": "view == tkbk-agent.backgroundTasks && viewItem =~ /tkbkTask:(applied|rejected|cancelled|failed)/"
				}
			]
		},
		"configuration": {
			"title": "TKBK Agent",
			"properties": {
				"tkbk-agent.subagents.autoRouteModels": {
					"type": "boolean",
					"default": true,
					"description": "Авто-роутинг моделей субагентов: роль «explore» (разведка по коду) работает на быстрой дешёвой модели TKBK, остальные роли — на модели основной задачи. Действует только с провайдером TKBK."
				},
				"tkbk-agent.subagents.fastModel": {
					"type": "string",
					"default": "glm-5.3",
					"description": "Модель из каталога TKBK для роли «explore» при включённом авто-роутинге (например glm-5.3, deepseek-v4-pro)."
				},
				"tkbk-agent.index.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Индексировать открытый проект для смыслового поиска по коду (инструмент codebase_search). Индекс хранится в ~/.tkbk/index и обновляется при изменении файлов."
				},
				"tkbk-agent.index.useEmbeddings": {
					"type": "boolean",
					"default": true,
					"description": "Строить семантический индекс через эмбеддинги шлюза TKBK (нужен провайдер TKBK и сохранённый ключ). Выключено или недоступно — работает лексический поиск без сети."
				},
				"tkbk-agent.index.embeddingModel": {
					"type": "string",
					"default": "text-embedding-3-small",
					"description": "Модель эмбеддингов из каталога TKBK для индекса кода."
				},
				"tkbk-agent.index.maxFileKb": {
					"type": "number",
					"default": 200,
					"minimum": 16,
					"maximum": 4096,
					"description": "Файлы больше этого размера (КБ) в индекс не попадают."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run package",
		"compile": "bun run check-types && bun run lint && bun esbuild.mjs",
		"compile-standalone": "bun run check-types && bun run lint && bun esbuild.mjs --standalone",
		"postcompile-standalone": "node scripts/package-standalone.mjs",
		"dev": "bun run protos && bun run watch",
		"watch": "bun run --parallel watch:esbuild watch:tsc",
		"watch:esbuild": "bun esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "bun run check-types && bun run lint && bun run build:production",
		"build:production": "bun run build:webview && bun esbuild.mjs --production",
		"protos": "node scripts/build-proto.mjs",
		"protos-python": "node scripts/build-python-proto.mjs",
		"download-ripgrep": "node scripts/download-ripgrep.mjs",
		"postprotos": "biome format --config-path ./biome.jsonc src/shared/proto src/core/controller src/hosts/ webview-ui/src/services src/generated --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist dist-standalone webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "bun run clean:build && bun run clean:deps",
		"compile-tests": "node ./scripts/build-tests.js",
		"watch-tests": "tsc -p . -w --outDir out",
		"check-types": "bun run protos && bunx tsc --noEmit && bun run check-types:compat && cd webview-ui && bunx tsc --noEmit",
		"check-types:compat": "bunx tsc --project tsconfig.vscode-compat.json --noEmit",
		"lint": "biome lint --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && bun run lint:proto",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"analyze:unused": "bunx --yes knip --config knip.json --include files,exports,types,enumMembers,duplicates",
		"analyze:unused:prod": "bunx --yes knip --config knip.json --production --include files,exports,types,enumMembers,dependencies",
		"analyze:unused:fix-exports": "node scripts/remove-unused-exports.mjs --apply",
		"analyze:unused:fix-exports:dry": "node scripts/remove-unused-exports.mjs",
		"format": "biome format --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error --semicolons=as-needed",
		"format:fix": "biome check --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --write --semicolons=as-needed",
		"fix:all": "biome check --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe --semicolons=as-needed",
		"ci:check-all": "bun run --parallel check-types lint format",
		"ci:build": "bun run protos && bun run build:webview && bun esbuild.mjs && bun run compile-tests",
		"pretest": "bun run compile && bun run compile-tests && bun run compile-standalone && bun run lint",
		"test": "bun run test:unit && bun run test:integration",
		"test:integration": "bun run compile-tests && vscode-test",
		"test:unit": "bun scripts/run-bun-unit-tests.ts",
		"test:vitest": "vitest run --config vitest.config.ts",
		"test:cloud": "vitest run --config vitest.cloud.config.ts",
		"test:vitest:watch": "vitest --config vitest.config.ts",
		"test:bun": "bun scripts/run-bun-tests.ts",
		"test:bun:unit": "bun scripts/run-bun-unit-tests.ts",
		"test:coverage": "bun run compile-tests && vscode-test --coverage",
		"test:sca-server": "bun --watch scripts/test-standalone-core-api-server.ts",
		"test:tp-orchestrator": "bun scripts/testing-platform-orchestrator.ts",
		"dev:mcp-oauth-test-server": "bun src/dev/mcp-oauth-test-server/server.ts",
		"dev:cloud-sessions": "bun src/dev/local-cloud-server.ts",
		"e2e": "playwright test -c playwright.config.ts",
		"test:e2e": "bun run build:production && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:ui": "bun scripts/interactive-playwright.ts",
		"install:all": "bun install",
		"dev:webview": "node scripts/clean-webview-vite-cache.mjs && cd webview-ui && bun run dev",
		"build:webview": "bun run protos && cd webview-ui && bun run build",
		"test:webview": "cd webview-ui && bun run test",
		"publish:marketplace": "node scripts/publish-marketplace.mjs",
		"publish:marketplace:prerelease": "node scripts/publish-marketplace.mjs --pre-release",
		"publish:marketplace:nightly": "node ./scripts/publish-nightly.mjs",
		"docs": "cd docs && bun run dev",
		"docs:check-links": "cd docs && bun run check",
		"docs:rename-file": "cd docs && bun run rename",
		"report-issue": "node scripts/report-issue.js",
		"storybook": "cd webview-ui && bun run storybook",
		"eval:smoke:run": "bun evals/smoke-tests/run-smoke-tests.ts"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
			"git add apps/vscode/proto/cline/state.proto"
		],
		"*": [
			"biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true --semicolons=as-needed"
		]
